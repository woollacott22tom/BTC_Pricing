[Unit]
Description=BTC Kalshi predictor - ingestion service
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/btc-kalshi-predictor
Environment=AWS_REGION=us-east-1
Environment=MODEL_BUCKET=btc-kalshi-model-artifacts-tom-8291
Environment=COINBASE_SECRET_NAME=btc-kalshi/coinbase-api-key
ExecStart=/usr/bin/python3 run_ingestion.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
