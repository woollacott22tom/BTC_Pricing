[Unit]
Description=Crypto.com BTC_USD ingestion service
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/btc-kalshi-predictor
Environment=AWS_REGION=us-east-1
ExecStart=/usr/bin/python3 crypto_ingestion.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
